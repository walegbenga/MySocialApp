{
  "name": "mysocialapp/api",
  "description": "MySocialApp versioned REST API",
  "type": "project",
  "require": {"php": "^8.2", "laravel/framework": "^12.0"},
  "require-dev": {"laravel/pint": "^1.18", "phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "@php artisan test", "lint": "@php vendor/bin/pint --test"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
